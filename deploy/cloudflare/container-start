#!/usr/bin/env bash
# container-start — server-mode entrypoint for the per-workspace engine
# (docs/cloudflare.md).
#
# The container runs the HTTP shim on :8080 for the life of the instance,
# and the Worker forwards the calling agent's requests to it. Disk is
# ephemeral, so this entrypoint restores the workspace's state from R2
# first (the shim re-uploads it after every change), and the shim handles
# SIGTERM with a final sync.
#
# Every boot step reports itself to R2 as boot.log — the one channel that
# works even when nothing else can talk to a dying instance.
set -euo pipefail

DB="${OPENOUTREACH_DB:-/app/data/db.sqlite3}"
STATE="${STATE_HOST:-state.internal}"
WS="${WORKSPACE_ID:-default}"
PREFIX="crm/$WS"
mkdir -p "$(dirname "$DB")" "$HOME"

log() { echo "[engine:$WS] $*" >&2 || true; }

# Boot transcript: the entrypoint's own narration lands in /tmp/boot.log — a
# plain file, so a hostile or closed platform stdout/stderr pipe can never
# fail a write and take the script down under `set -e` — and every step
# uploads it to R2, so a dying instance still leaves its story behind.
# The shim itself talks to the platform's real pipes (fds 3/4), so live logs
# keep working wherever the platform can carry them.
exec 3>&1 4>&2
exec >> /tmp/boot.log 2>&1
boot_flush() { curl -sS --max-time 5 -X PUT --data-binary @/tmp/boot.log "http://$STATE/$PREFIX/boot.log" 2>/dev/null || true; }
trap 'boot_flush' EXIT
step() { log "$*"; boot_flush; }

step "entrypoint reached (ws=$WS uid=$(id -u))"

# ── restore the state this instance starts from ─────────────────────
# (the job document is read by the shim itself at boot)

restore() { # restore <r2-key> <dest>: 0 fetched, 1 absent, 2 unreachable
    local code
    code=$(curl -sS --max-time 300 -o "$2" -w '%{http_code}' "http://$STATE/$PREFIX/$1" 2>/dev/null) || return 2
    case "$code" in
        200) return 0 ;;
        404) rm -f "$2"; return 1 ;;
        *) return 2 ;;
    esac
}

rc=0; restore db.sqlite3 "$DB" || rc=$?
case "$rc" in
    0) step "CRM restored from R2" ;;
    1) step "no CRM in R2 yet — fresh workspace" ;;
    *) step "FATAL: state store unreachable (rc=$rc)"; exit 1 ;;
esac

rc=0; restore home.tar.gz /tmp/home.tar.gz || rc=$?
if [ "$rc" -eq 0 ]; then
    tar -xzf /tmp/home.tar.gz -C "$HOME" && step "home restored" || step "warning: home unpack failed"
    rm -f /tmp/home.tar.gz
else
    rc=0; restore home.tar.zst /tmp/home.tar.zst || rc=$?   # legacy single-tenant name
    if [ "$rc" -eq 0 ]; then
        tar -I zstd -xf /tmp/home.tar.zst -C "$HOME" || step "warning: home unpack failed"
        rm -f /tmp/home.tar.zst
    else
        step "no home in R2 — first run"
    fi
fi

# One settings module, one migration graph: bring the schema current before
# the shim serves anything, so ingest never lands on missing tables. Never
# fatal: a failed migration is surfaced by /check and the verbs themselves —
# killing the container here would only hide the reason.
step "migrating"
openoutreach migrate --no-input >&2 || step "WARNING: migrate failed ($?); continuing"
step "migrate done"

# The shim is the container's reason to exist; supervise it rather than exec
# so a crash at boot is logged (container stdout + boot.log) and retried
# instead of taking the instance down with no trace. SIGTERM still reaches
# the shim, which syncs state and exits cleanly.
term() { [ -n "${SHIM_PID:-}" ] && kill -TERM "$SHIM_PID" 2>/dev/null; wait; exit 0; }
trap term TERM INT
step "starting the engine shim on :8080"
while true; do
    python /shim.py >&3 2>&4 &
    SHIM_PID=$!
    wait "$SHIM_PID" && break
    step "WARNING: shim exited ($?); restarting in 5s"
    sleep 5
done
